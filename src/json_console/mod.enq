pub import refrain::presentation::Console
import refrain::json_render::{render_json, render_json_source}

impl for Console {
    pub fn json[Value](self, value: Value) ->() {
        self.println(render_json(value))
    }

    pub fn json_source(self, source: str) ->() {
        self.println(render_json_source(source))
    }
}
