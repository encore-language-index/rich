//! Presentation accepts JSON text; values are stringified by the caller.
//! Data parsing stays in the caller's codec package.
extern fn encore_text_builder_new() -> usize
extern fn encore_text_builder_append(builder: usize, value: str) ->()
extern fn encore_text_builder_finish(builder: usize) -> str

pub fn render_json(source: str) -> str {
    ret indent_json(source)
}

/// Formats JSON text without parsing it. Validate untrusted text with the
/// caller's JSON package before rendering; pass value.stringify() when a parsed value is available.
pub fn render_json_source(source: str) -> str {
    ret indent_json(source)
}

fn append(builder: usize, value: str) ->() {
    unsafe {
        encore_text_builder_append(builder, value)
    }
}
fn line(builder: usize, depth: usize) ->() {
    append(builder, "\n")
    for _ in 0..depth {
        append(builder, "  ")
    }
}
// Input comes from the value's stringify implementation, so this function
// only handles layout. Quotes and escapes are copied without reinterpretation.
fn indent_json(source: str) -> str {
    let builder = unsafe {
        encore_text_builder_new()
    }
    let mut depth = 0_usize
    let mut start = 0_usize
    let mut quoted = false
    let mut escaped = false
    for i in 0..source.byte_len() {
        let byte = source.byte_at(i)
        if quoted {
            if escaped {
                escaped = false
            } elif byte == 92 {
                escaped = true
            } elif byte == 34 {
                quoted = false
            }
            continue
        }
        if byte == 34 {
            quoted = true continue
        }
        if byte == 123 || byte == 91 {
            append(builder, source.slice_bytes(start, i + 1 - start))
            let closing = if byte == 123 {
                125_u8
            } else {
                93_u8
            }
            if i + 1 < source.byte_len() && source.byte_at(i + 1) != closing {
                depth += 1 line(builder, depth)
            }
            start = i + 1
        } elif byte == 125 || byte == 93 {
            let opening = if byte == 125 {
                123_u8
            } else {
                91_u8
            }
            let empty = i != 0 && source.byte_at(i - 1) == opening
            append(builder, source.slice_bytes(start, i - start))
            if !empty {
                if depth > 0 {
                    depth -= 1
                }
                line(builder, depth)
            }
            append(builder, source.slice_bytes(i, 1)) start = i + 1
        } elif byte == 44 {
            append(builder, source.slice_bytes(start, i + 1 - start))
            line(builder, depth) start = i + 1
        } elif byte == 58 {
            append(builder, source.slice_bytes(start, i + 1 - start))
            append(builder, " ") start = i + 1
        }
    }
    append(builder, source.slice_bytes(start, source.byte_len() - start))
    unsafe {
        ret encore_text_builder_finish(builder)
    }
}
