import std::os::{file_exists, read_file, write_file}
import log::{Writable, Logger, Formatter}
import rich::logging::compact_formatter

struct CaptureWriter {
    path: str
}

impl Writable for CaptureWriter {
    fn write(self: CaptureWriter, value: str) -> i32 {
        let mut current = ""
        if file_exists(self.path) {
            current = read_file(self.path)
        }
        ret write_file(self.path, current + value)
    }
}

fn main() -> u32 {
    let console = Logger::console_with_formatter("rich-console", compact_formatter(Formatter::plain()))
    console.info("console sink ready")

    let mut file = Logger::new("rich-file")
    file.add_file_sink("target/rich-example.log")
    file.warn("file sink ready")

    let mut writer = Logger::new("rich-writer")
    writer.add_writer_sink(CaptureWriter{"target/rich-writer.log"} as dyn Writable)
    writer.error("writer sink ready")
    ret 0_u32
}
